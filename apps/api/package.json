{
  "name": "@musicorbit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "reset-password": "sh -c 'if command -v tsx >/dev/null 2>&1 && [ -f src/cli/resetPassword.ts ]; then exec tsx src/cli/resetPassword.ts \"$@\"; else exec node dist/cli/resetPassword.js \"$@\"; fi' --",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@musicorbit/shared": "0.1.0",
    "better-sqlite3": "^11.9.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.41.0",
    "fastify": "^5.2.2",
    "music-metadata": "^11.2.0",
    "node-taglib-sharp": "^6.0.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.30.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
