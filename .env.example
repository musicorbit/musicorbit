# MusicOrbit configuration
# Copy this file to .env and adjust for your environment:
#   cp .env.example .env

# Server settings (4410 = nod to 44.1 kHz audio)
PORT=4410
HOST=0.0.0.0
LOG_LEVEL=info

# Paths (relative paths resolve from the repository root)
# Directory where your audio library lives
MUSIC_DIR=./sample-music
# Directory where MusicOrbit stores its SQLite database and cover art cache
DATA_DIR=./data

# Metadata & artwork
# Set to false to disable external artist portrait lookups (offline / privacy mode)
FETCH_ARTIST_IMAGES=true

# Optional Soulseek integration via slskd
# Recommended: configure right inside the UI (System & Scanner → slskd) with no .env edit needed.
# Env vars below are optional fallbacks only if not configured in the UI.
# SLSKD_URL=http://localhost:5030
# SLSKD_API_KEY=

# Import pipeline & MusicBrainz tagging (Step 5)
# Folder where completed downloads land before MusicOrbit tags and moves them into MUSIC_DIR
DOWNLOADS_DIR=./downloads
# Minimum MusicBrainz confidence (0-100) to auto-import without manual review
AUTO_IMPORT_THRESHOLD=85

# Authentication (enabled by default — first run prompts to create the Admin account)
# Set to false only for local single-user dev/testing
AUTH_ENABLED=true
