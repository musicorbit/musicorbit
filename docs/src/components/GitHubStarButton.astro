---
interface Props {
  repo?: string;
}

const { repo = "musicorbit/musicorbit" } = Astro.props;
const href = `https://github.com/${repo}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="mo-gh-pill"
  data-gh-star-repo={repo}
  aria-label="Star MusicOrbit on GitHub"
>
  <svg
    viewBox="0 0 16 16"
    width="15"
    height="15"
    fill="currentColor"
    class="mo-gh-mark"
    aria-hidden="true"
  >
    <path
      d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
    ></path>
  </svg>
  <span class="mo-gh-label">GitHub</span>
  <span class="mo-gh-sep" aria-hidden="true"></span>
  <span class="mo-gh-star-wrap">
    <svg
      viewBox="0 0 24 24"
      width="13"
      height="13"
      fill="currentColor"
      class="mo-gh-star-icon"
      aria-hidden="true"
    >
      <path
        d="M12 2.5l2.92 5.92 6.53.95-4.72 4.6 1.11 6.5L12 17.4l-5.84 3.07 1.11-6.5-4.72-4.6 6.53-.95L12 2.5z"
      ></path>
    </svg>
    <span class="mo-gh-count" data-gh-star-count>Star</span>
  </span>
</a>

<script>
  const CACHE_KEY = "mo-gh-stars-v1";
  const CACHE_TTL_MS = 15 * 60 * 1000;

  function formatStars(count: number): string {
    if (count >= 1000) {
      const k = count / 1000;
      return `${k >= 10 ? k.toFixed(0) : k.toFixed(1).replace(/\.0$/, "")}k`;
    }
    return String(count);
  }

  function applyStarCount(count: number) {
    if (count <= 0) return;
    const formatted = formatStars(count);
    document.querySelectorAll("[data-gh-star-count]").forEach((el) => {
      el.textContent = formatted;
    });
  }

  async function loadStars() {
    const firstPill = document.querySelector<HTMLElement>("[data-gh-star-repo]");
    const repo = firstPill?.dataset.ghStarRepo;
    if (!repo) return;

    try {
      const raw = localStorage.getItem(CACHE_KEY);
      if (raw) {
        const cached = JSON.parse(raw) as { repo: string; count: number; ts: number };
        if (cached.repo === repo && Date.now() - cached.ts < CACHE_TTL_MS) {
          applyStarCount(cached.count);
          return;
        }
      }
    } catch {
      // Ignore storage errors
    }

    try {
      const res = await fetch(`https://api.github.com/repos/${repo}`, {
        headers: { Accept: "application/vnd.github+json" },
      });
      if (!res.ok) return;
      const data = (await res.json()) as { stargazers_count?: unknown };
      if (typeof data.stargazers_count === "number") {
        applyStarCount(data.stargazers_count);
        try {
          localStorage.setItem(
            CACHE_KEY,
            JSON.stringify({ repo, count: data.stargazers_count, ts: Date.now() }),
          );
        } catch {
          // Ignore storage errors
        }
      }
    } catch {
      // Offline or rate-limited — keep graceful "Star" label
    }
  }

  void loadStars();
</script>

<style>
  .mo-gh-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.05);
    color: #e9ecf5;
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    transition:
      border-color 150ms ease,
      background 150ms ease,
      color 150ms ease;
  }

  .mo-gh-pill:hover {
    border-color: rgba(245, 158, 11, 0.55);
    background: rgba(245, 158, 11, 0.12);
    color: #faf7f2;
  }

  :global([data-theme="light"]) .mo-gh-pill {
    border-color: rgba(15, 23, 42, 0.16);
    background: rgba(15, 23, 42, 0.04);
    color: #1e293b;
  }

  :global([data-theme="light"]) .mo-gh-pill:hover {
    border-color: rgba(217, 119, 6, 0.55);
    background: rgba(245, 158, 11, 0.12);
    color: #0f172a;
  }

  .mo-gh-mark {
    flex-shrink: 0;
  }

  .mo-gh-sep {
    width: 1px;
    height: 13px;
    background: rgba(255, 255, 255, 0.18);
  }

  :global([data-theme="light"]) .mo-gh-sep {
    background: rgba(15, 23, 42, 0.18);
  }

  .mo-gh-star-wrap {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .mo-gh-star-icon {
    color: #fbbf24;
    flex-shrink: 0;
  }

  :global([data-theme="light"]) .mo-gh-star-icon {
    color: #d97706;
  }
</style>
